{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "composite": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["vite/client"],
        "moduleResolution": "bundler"
    }
}
